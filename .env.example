# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SENDING_DOMAIN=s

# --- Supabase (§8a) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (§8a, §9) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- Polar (§10) ---
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# --- Cron (§8c) ---
# Shared secret required in the header of POST /api/cron/dispatch
CRON_SECRET=

# Global kill switch — set to "true" to halt ALL sending (§8c).
# You will want this at 2am one day.
SENDING_ENABLED=true
