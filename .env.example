# Copy to .env.local (or .env) and fill in. Never commit the filled-in copy.

# --- Site ---
# The public origin. robots.txt and sitemap.xml are generated from this, so it
# MUST be the real domain in production or Search Console will reject them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SENDING_DOMAIN=send.onemoreemail.app

# --- Supabase ---
# Dashboard > Project Settings > API
#   Project URL          -> NEXT_PUBLIC_SUPABASE_URL
#   service_role / secret -> SUPABASE_SERVICE_ROLE_KEY   (SERVER ONLY, secret)
#   anon / publishable    -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# The anon key is optional: nothing in this app uses it yet, because only
# /api/subscribe talks to Supabase and it uses the service role. It is here so
# `npm run verify:supabase` can prove the browser cannot read the waitlist.
#
# Never put the service_role key in a NEXT_PUBLIC_* variable. That prefix
# inlines the value into the JavaScript bundle sent to every visitor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (email sending, not wired yet) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- Polar (billing, not wired yet) ---
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# --- Cron (the send dispatcher, not wired yet) ---
# Shared secret required in the header of POST /api/cron/dispatch
CRON_SECRET=

# Global kill switch: set to "false" to halt ALL sending.
# You will want this at 2am one day.
SENDING_ENABLED=true
